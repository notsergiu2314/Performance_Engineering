# Full baseline for one exclusive HAICGU compute node (TaiShan 2280):
# 2 x Kunpeng 920 (ARMv8), 64 cores per socket, 128 physical cores, no SMT,
# expected 4 NUMA domains of 32 cores (verify in environment.txt / job log).
# KERNELS RANKS THREADS [DECK]; ranks*threads = 128 throughout.
# Layouts: pure OpenMP, one rank per socket (2x64), one rank per NUMA domain
# (4x32), hybrid 16x8, pure MPI. Only decks with a test_problem line are used
# so every run carries a QA check (clover_bm64*.in have no reference answer).

# quick cross-run reference: 960^2, 87 steps (test_problem 2) -- ~7k cells/rank at 128x1
fortran 1   128
c       1   128
fortran 2   64
c       2   64
fortran 4   32
c       4   32
fortran 16  8
c       16  8
fortran 128 1
c       128 1

# memory-bound regime: 3840^2, 87 steps (test_problem 4) -- the main baseline at this scale
fortran 1   128 clover_bm16_short.in
c       1   128 clover_bm16_short.in
fortran 2   64  clover_bm16_short.in
c       2   64  clover_bm16_short.in
fortran 4   32  clover_bm16_short.in
c       4   32  clover_bm16_short.in
fortran 16  8   clover_bm16_short.in
c       16  8   clover_bm16_short.in
fortran 128 1   clover_bm16_short.in
c       128 1   clover_bm16_short.in

# long run, shock crosses every chunk boundary: 960^2, 2955 steps (test_problem 3)
fortran 128 1   clover_bm.in
c       128 1   clover_bm.in
fortran 4   32  clover_bm.in
c       4   32  clover_bm.in
