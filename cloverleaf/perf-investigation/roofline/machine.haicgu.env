# Theoretical constants for a HAICGU TaiShan 2280 node (2 x Kunpeng 920-6426, TaiShan v110
# cores, ARMv8.2, 128-bit NEON). Only used for the "theoretical" rows in machine.csv.
GHZ=2.6
FLOP_PER_CYCLE=8            # 2 FP/SIMD pipes x 2 FP64 lanes x 2 (FMA); verify with peak_fma
CORES_PER_SOCKET=64
SOCKETS=2
NUMA_PER_SOCKET=2           # 4 NUMA domains of 32 cores
MEM_CHANNELS_PER_SOCKET=8
MEM_MTS=2666                # DDR4-2666 -> 8 x 2666e6 x 8 B = 170.6 GB/s per socket
MEM_BUS_BYTES=8
STREAM_SITE_TRIAD_GBS=140   # per node, quoted on https://haicgu.github.io/
